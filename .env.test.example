# .env.test.example - Example test database configuration
# Copy this file to .env.test and customize for your local environment
#
# IMPORTANT: DO NOT use production database credentials here!
# This file is for running tests locally and will perform destructive operations.

# ============================================================================
# SAFETY FLAG (REQUIRED)
# ============================================================================
# Must be set to 'true' to run tests - this prevents accidental test execution
EXOSKELETON_TEST_MODE=true

# ============================================================================
# TEST DATABASE CONFIGURATION
# ============================================================================
# IMPORTANT: Database name MUST contain 'test' for safety
# Examples: exoskeleton_test, test_exoskeleton, exoskeleton_testing, etc.

TEST_DB_HOST=localhost
TEST_DB_PORT=3306
TEST_DB_NAME=exoskeleton_test
TEST_DB_USER=exoskeleton_test
TEST_DB_PASSWORD=test_password

# ============================================================================
# BROWSER FOR PDF TESTS (OPTIONAL)
# ============================================================================
# Browser executable name for PDF generation tests
# Common values: chromium-browser, google-chrome, chromium, chrome
TEST_BROWSER=chromium-browser
